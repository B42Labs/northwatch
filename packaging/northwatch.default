# /etc/default/northwatch — environment for northwatch.service
# Flags > env vars; this file sets env vars. Uncomment to override defaults.

# OVN Northbound DB (required) — comma-separated for Raft failover
NORTHWATCH_OVN_NB_ADDR=tcp:127.0.0.1:6641
# OVN Southbound DB (required)
NORTHWATCH_OVN_SB_ADDR=tcp:127.0.0.1:6642

# HTTP listen address. The binary already defaults to loopback; binding anything
# else requires NORTHWATCH_API_TOKENS (or NORTHWATCH_INSECURE_NO_AUTH), and puts
# the open read surface on the network — put an authenticating proxy in front.
NORTHWATCH_LISTEN=127.0.0.1:8080

# Bearer tokens authorizing mutating API requests, as comma-separated
# name=token pairs. The name is recorded as the actor on every write-audit
# entry. Without tokens, all mutating endpoints answer 401.
# Generate one with: openssl rand -hex 32
#NORTHWATCH_API_TOKENS=ops=<token>
# Or keep them out of the process table (JSON: {"ops": "<token>"}):
#NORTHWATCH_API_TOKENS_FILE=/etc/northwatch/tokens.json

# Persisted in the state directory the package creates (/var/lib/northwatch)
NORTHWATCH_HISTORY_DB_PATH=/var/lib/northwatch/history.db

# Multi-cluster JSON config (overrides the flat NB/SB addrs above)
#NORTHWATCH_CONFIG_FILE=/etc/northwatch/clusters.json

# --- the remaining knobs, all optional (see docs/reference/cli.md) ---
#NORTHWATCH_MONITOR_BATCH_DELAY=200ms
#NORTHWATCH_MONITOR_SKIP_TABLES=Logical_Flow,MAC_Binding,FDB
#NORTHWATCH_WRITE_ENABLED=false
#NORTHWATCH_WRITE_PLAN_TTL=10m
#NORTHWATCH_WRITE_RATE_LIMIT=30
#NORTHWATCH_SNAPSHOT_INTERVAL=5m
#NORTHWATCH_EVENT_RETENTION=24h
#NORTHWATCH_EVENT_MAX_COUNT=0
#NORTHWATCH_SNAPSHOT_MAX_COUNT=500
#NORTHWATCH_ENRICHMENT_CACHE_TTL=5m
#NORTHWATCH_ALERT_WEBHOOK_URLS=
#NORTHWATCH_WS_ALLOWED_ORIGINS=
# OpenStack enrichment: OS_AUTH_URL, OS_USERNAME, OS_PASSWORD, OS_PROJECT_NAME, ...
# Kubernetes enrichment: NORTHWATCH_KUBE_ENRICHMENT=true, KUBECONFIG=..., NORTHWATCH_KUBE_CONTEXT=...
